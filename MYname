
<!DOCTYPE html>
<html>
<head>
    <title>Buy and Sell</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="product-card">
    <img src="headphones.jpg" alt="Product">

    <h2>Wireless Headphones</h2>
    <h3>₱850.00</h3>

    <button id="heartBtn" onclick="toggleLike()">
        ❤️ Like
    </button>

    <p id="likeCount">15 Reactions</p>
</div>

<script src="script.js"></script>
</body>
</html>

body {
    font-family: Arial;
    background: #f2f2f2;
    display: flex;
    justify-content: center;
    padding: 50px;
}

.product-card {
    background: white;
    width: 300px;
    padding: 20px;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 4px 10px #ccc;
}

.product-card img {
    width: 100%;
    border-radius: 10px;
}

button {
    background: #ff4d6d;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 16px;
}

button:hover {
    background: #e60033;
}

let likes = 15;
let isLiked = false;

function toggleLike() {

    const button = document.getElementById("heartBtn");
    const count = document.getElementById("likeCount");

    if (isLiked) {
        likes--;
        button.innerHTML = "❤️ Like";
        isLiked = false;
    } else {
        likes++;
        button.innerHTML = "💖 Liked";
        isLiked = true;
    }

    count.innerHTML = likes + " Reactions";
}
